# Compose identity and host ports.
COMPOSE_PROJECT_NAME=llm-proxy
LLM_PROXY_PORT=18900
CODEX_PROXY_PORT=10531

# Runtime data lives inside the containers at /data.
DATA_DIR=/data
DEV_MODE=true

# Provider families and their credentials.
ENABLE_WINDSURF=false
WINDSURF_API_KEY=

ENABLE_CLAUDE=false
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

ENABLE_CODEX=false

ENABLE_COPILOT=false
COPILOT_GITHUB_TOKEN=

# Smart routing policy.
LLM_COST_TARGET=3
LLM_THINKING_TARGET=medium
LLM_SPEED_TARGET=4
LLM_ROUTING_POLICY=balanced

# Windsurf source mode.
WINDSURF_ENTERPRISE=false
