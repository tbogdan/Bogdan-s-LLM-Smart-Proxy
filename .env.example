# Required API keys (get free from each provider)
COPILOT_TOKEN=gho_xxx
MISTRAL_API_KEY=xxx
GROQ_API_KEY=gsk_xxx
CEREBRAS_API_KEY=csk-xxx
SAMBANOVA_API_KEY=xxx
NVIDIA_API_KEY=nvapi-xxx
GEMINI_API_KEY=AIzaxxx
OPENROUTER_API_KEY=sk-or-v1-xxx
CLOUDFLARE_API_KEY=cfut_xxx
CLOUDFLARE_ACCOUNT_ID=your_account_id
SILICONFLOW_API_KEY=sk-xxx
BIGMODEL_API_KEY=xxx
DEEPSEEK_API_KEY=sk-xxx
ALIBABA_API_KEY=sk-xxx
COHERE_API_KEY=xxx
OLLAMA_API_KEY=xxx
HF_TOKEN=hf_xxx
OPENAI_API_KEY=sk-proj-xxx
# Cline Provider — 356 models (28 free) via app.cline.bot
# Auth: sign up at https://app.cline.bot → Settings → API Keys → generate key
CLINE_API_KEY=

# ModelScope — 65 free models (DeepSeek V3.2, V4 Flash, Qwen3 Coder, R1)
# Auth: get token at https://www.modelscope.ai/my/access/token (bind Alibaba Cloud account)
MODELSCOPE_API_KEY=

# MemPalace (auto-configured in docker-compose, optional standalone)
MEMPALACE_URL=http://mempalace-mcp:8891
MEMPALACE_ENABLED=true
MEMPALACE_MAX_INJECT_TOKENS=2000

# OPTIONAL — higher limits if you have a key, works without too
LLM7_API_KEY=

# NO KEY NEEDED — these work without authentication
# OVH, Kilo (anonymous) — auto-configured, no env vars required

# ============================================================
# LOCAL GATEWAY PROXIES (set ENABLE_X=true to activate)
# ============================================================

# Kiro Gateway — free Claude Sonnet 4, Haiku 4.5
# Auth: run "node kiro-auth.js" → opens browser OAuth → auto-captures token
ENABLE_KIRO=false
KIRO_API_KEY=proxy

# OpenAI Codex Proxy — GPT-5.x, o3, o4-mini via ChatGPT subscription OAuth
# Auth: run "npx @openai/codex login" then copy ~/.codex/auth.json to data/codex-auth.json
ENABLE_CODEX=false
CODEX_API_KEY=proxy
REFRESH_TOKEN=
PROFILE_ARN=
KIRO_REGION=us-east-1
