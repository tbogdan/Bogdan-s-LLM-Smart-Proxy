# Required API keys (get free from each provider)
COPILOT_TOKEN=gho_xxx
MISTRAL_API_KEY=xxx
GROQ_API_KEY=gsk_xxx
CEREBRAS_API_KEY=csk-xxx
SAMBANOVA_API_KEY=xxx
NVIDIA_API_KEY=nvapi-xxx
GEMINI_API_KEY=AIzaxxx
OPENROUTER_API_KEY=sk-or-v1-xxx
CLOUDFLARE_API_KEY=cfut_xxx
CLOUDFLARE_ACCOUNT_ID=your_account_id
SILICONFLOW_API_KEY=sk-xxx
BIGMODEL_API_KEY=xxx
DEEPSEEK_API_KEY=sk-xxx
ALIBABA_API_KEY=sk-xxx
COHERE_API_KEY=xxx
OLLAMA_API_KEY=xxx
HF_TOKEN=hf_xxx
OPENAI_API_KEY=sk-proj-xxx
# Cline Provider — 356 models (28 free) via app.cline.bot
# Auth: sign up at https://app.cline.bot → Settings → API Keys → generate key
CLINE_API_KEY=

# ModelScope — 65 free models (DeepSeek V3.2, V4 Flash, Qwen3 Coder, R1)
# Auth: get token at https://www.modelscope.ai/my/access/token (bind Alibaba Cloud account)
MODELSCOPE_API_KEY=

# OPTIONAL — higher limits if you have a key, works without too
LLM7_API_KEY=

# NO KEY NEEDED — these work without authentication
# OVH, Kilo (anonymous) — auto-configured, no env vars required

# ============================================================
# MEMORY / GRAPHITI INTEGRATION (optional)
# ============================================================

# Set to "false" to disable all memory features (default: enabled)
# MEMORY_ENABLED=true

# Backend: "local" (session-only, no DB), "graphiti" or "neo4j" (graph store)
# MEMORY_BACKEND=local

# Max tokens to inject from recalled memories into context
# MEMORY_MAX_INJECT_TOKENS=2000

# Max characters per compacted archive entry
# MEMORY_ARCHIVE_MAX_CHARS=30000

# --- Neo4j / Graphiti graph store (required when MEMORY_BACKEND=graphiti or neo4j) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# --- Graphiti MCP semantic sidecar (optional, enriches graph recalls) ---
# GRAPHITI_MCP_ENABLED=false
# GRAPHITI_MCP_URL=http://localhost:8000
# GRAPHITI_MCP_OUTBOX_BATCH=5
# GRAPHITI_MCP_OUTBOX_MAX_DRAIN_BATCHES=1
# GRAPHITI_MCP_OUTBOX_DRAIN_RESCHEDULE_MS=60000

# ============================================================
# LOCAL GATEWAY PROXIES (set ENABLE_X=true to activate)
# ============================================================

# Claude API — direct Anthropic API key
# Auth: get API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ENABLE_CLAUDE=false

# GitHub Copilot — GitHub Copilot subscription token
# Auth: run "npm run copilot-auth" → opens browser OAuth → auto-captures token
COPILOT_GITHUB_TOKEN=
ENABLE_COPILOT=false

# Windsurf — Windsurf IDE subscription token
# Auth: run "npm run windsurf-auth" → opens browser OAuth → auto-captures token
WINDSURF_API_KEY=
ENABLE_WINDSURF=false

# Kiro Gateway — free Claude Sonnet 4, Haiku 4.5
# Auth: run "npm run kiro-auth" → opens browser OAuth → auto-captures token
ENABLE_KIRO=false
KIRO_API_KEY=proxy

# OpenAI Codex Proxy — GPT-5.x, o3, o4-mini via ChatGPT subscription OAuth
# Auth: run "npx @openai/codex login" then copy ~/.codex/auth.json to data/codex-auth.json
ENABLE_CODEX=false
CODEX_API_KEY=proxy
REFRESH_TOKEN=
PROFILE_ARN=
KIRO_REGION=us-east-1
