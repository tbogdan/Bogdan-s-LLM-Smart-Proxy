# Host port for the proxy. Containers always listen on 18900.
LLM_PROXY_PORT=18900
DATA_DIR=/data
DEV_MODE=false
ENABLE_WINDSURF=false
WINDSURF_API_KEY=
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ENABLE_CODEX=false
CODEX_API_KEY=proxy
MEMPALACE_ENABLED=false
MEMPALACE_URL=http://mempalace-mcp:8891
MEMPALACE_MAX_INJECT_TOKENS=2000
