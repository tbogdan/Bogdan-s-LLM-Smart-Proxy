# Optional Compose project name controls generated container names.
COMPOSE_PROJECT_NAME=llm-proxy

# Host ports. Containers keep their internal ports.
LLM_PROXY_PORT=18900
CODEX_PROXY_PORT=10531
DATA_DIR=/data
DEV_MODE=false
ENABLE_WINDSURF=false
WINDSURF_API_KEY=
WINDSURF_MODELS=
WINDSURF_MODELS_JSON=
WINDSURF_MODELS_URL=
WINDSURF_IDE_VERSION=2.3.9
WINDSURF_USER_AGENT=connect-es/1.5.0
WINDSURF_ENTERPRISE=false
WINDSURF_API_ORIGIN=
WINDSURF_CHAT_ORIGIN=
WINDSURF_CONNECT_TIMEOUT_MS=120000
WINDSURF_CONNECT_TIMEOUT_HEADER=true
WINDSURF_INCLUDE_ACCEPT_HEADER=false
WINDSURF_CONNECT_RETRIES=1
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
ENABLE_CODEX=false
CODEX_API_KEY=proxy
ENABLE_COPILOT=false
COPILOT_GITHUB_TOKEN=
GITHUB_COPILOT_CLIENT_ID=01ab8ac9400c4e429b23
GITHUB_COPILOT_SCOPE=read:user user:email
COPILOT_MODELS=
COPILOT_MODELS_URL=
LLM_COST_TARGET=3
LLM_THINKING_TARGET=medium
LLM_SPEED_TARGET=4
LLM_ROUTING_POLICY=balanced
LLM_PROXY_AI_SUMMARY_MODEL=auto-text
LLM_PROXY_AI_SUMMARY_TIMEOUT_MS=12000
LLM_PROXY_AI_SUMMARY_MAX_TOKENS=500
LLM_PROXY_AI_SUMMARY_MIN_MESSAGES=1
MEMORY_ENABLED=true
MEMORY_BACKEND=local
MEMORY_MAX_INJECT_TOKENS=2000
GRAPHITI_NEO4J_URI=bolt://graphiti-neo4j:7687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=graphiti-memory-local
GRAPHITI_NEO4J_PORT=7687
GRAPHITI_NEO4J_HTTP_PORT=7474
