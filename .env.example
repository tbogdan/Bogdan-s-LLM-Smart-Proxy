# Compose identity and host ports.
COMPOSE_PROJECT_NAME=llm-proxy
LLM_PROXY_PORT=18900
CODEX_PROXY_PORT=10531

# Bounded inbound HTTP bodies (positive integers; invalid values use these defaults).
LLM_PROXY_MAX_BODY_BYTES=26214400
LLM_PROXY_BODY_TIMEOUT_MS=300000
LLM_PROXY_MAX_INFLIGHT_REQUESTS=128
LLM_PROXY_MAX_INFLIGHT_BODY_BYTES=67108864

# Runtime data lives inside the containers at /data.
DATA_DIR=/data
DEV_MODE=false

# Provider families and their credentials.
ENABLE_WINDSURF=false
WINDSURF_API_KEY=

ENABLE_CLAUDE=false
CLAUDE_CODE_OAUTH_TOKEN=
OPENCODE_API_KEY=
OPENCODE_GO_API_KEY=
OPENCODE_ORG_ID=
OPENCODE_GO_ORG_ID=
OPENCODE_NATIVE_COMPAT=false
ANTHROPIC_API_KEY=
CLAUDE_CODE_DEVICE_ID=
CLAUDE_CODE_ACCOUNT_UUID=
CLAUDE_CODE_ORGANIZATION_UUID=
CLAUDE_CODE_SESSION_ID=
CLAUDE_CODE_VERSION=
CLAUDE_CODE_BILLING_BUILD=
CLAUDE_CODE_MAX_TOKENS=
CLAUDE_CODE_STAINLESS_PACKAGE_VERSION=
CLAUDE_CODE_BETAS=
CLAUDE_CODE_OUTPUT_EFFORT=

ENABLE_CODEX=false
LLM_PROXY_CODEX_VIRTUAL_SUBAGENTS=true

ENABLE_COPILOT=false
COPILOT_GITHUB_TOKEN=

KIMI_API_KEY=
XIAOMI_API_KEY=
OLLAMA_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NEBIUS_API_KEY=
HYPERBOLIC_API_KEY=

# Smart routing policy.
LLM_COST_TARGET=3
LLM_THINKING_TARGET=medium
LLM_SPEED_TARGET=4
LLM_ROUTING_POLICY=balanced
LLM_PROXY_PROMPT_INJECTION=full

# Windsurf source mode.
WINDSURF_ENTERPRISE=false

# Absolute ancillary Codex backend operation deadline, including response streaming.
# Positive integer milliseconds; unset/invalid/nonpositive values use 300000.
LLM_PROXY_CODEX_BACKEND_TIMEOUT_MS=300000

# Runtime caches: positive integers only; invalid/zero values use these defaults.
# FIFO (reads do not refresh age), fixed insertion TTL; authoritative task,
# security, account and provider-health state is never generically evicted.
LLM_PROXY_CACHE_MAX_ENTRIES=2000
LLM_PROXY_CACHE_TTL_MS=3600000
LLM_PROXY_CACHE_MAX_PATHS_PER_SESSION=256
# Shared UTF-8 payload/key estimate, not measured JS heap. Oversize skips caching.
LLM_PROXY_CACHE_MAX_BYTES=67108864
LLM_PROXY_CLEANUP_INTERVAL_MS=3600000
# Unmapped-route diagnostics have a separate 512-entry cap; approval audit tail
# has a 500-record cap and shares the byte budget. Disk audit is unaffected.

# Docker Compose local service resource limits (no NODE_OPTIONS override).
LLM_PROXY_MEMORY_LIMIT=2g
LLM_PROXY_CPU_LIMIT=2.0
LLM_PROXY_PIDS_LIMIT=256
CODEX_PROXY_MEMORY_LIMIT=1g
CODEX_PROXY_CPU_LIMIT=1.0
CODEX_PROXY_PIDS_LIMIT=256
# Benchmark gates: informational unless explicitly enforced; timing/memory opt in.
BENCH_ENFORCE_GATES=false
# BENCH_MAX_P95_MS=100
# BENCH_MAX_P99_MS=150
# BENCH_MIN_SUCCESSFUL_RPS=50
# BENCH_MAX_RSS_GROWTH_BYTES=536870912
# BENCH_MAX_HEAP_GROWTH_BYTES=268435456

# Shared upstream transport budgets (positive integers; zero is not unlimited).
LLM_PROXY_HTTP_MAX_SOCKETS=64
LLM_PROXY_HTTP_MAX_TOTAL_SOCKETS=256
LLM_PROXY_HTTP_MAX_FREE_SOCKETS=16
LLM_PROXY_HTTP_MAX_REQUESTS=512
LLM_PROXY_UPSTREAM_TIMEOUT_MS=300000
LLM_PROXY_MAX_UPSTREAM_RESPONSE_BYTES=33554432
LLM_PROXY_MAX_UPSTREAM_ERROR_BYTES=1048576
LLM_PROXY_MAX_STREAM_BUFFER_BYTES=33554432
LLM_PROXY_MAX_RETAINED_UPSTREAM_BYTES=134217728
LLM_PROXY_NATIVE_MAX_REQUESTS=32
LLM_PROXY_METRICS_SAMPLE_SIZE=1024
