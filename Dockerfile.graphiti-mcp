# Upstream already forwards `config.providers.openai.api_url` as the LLM
# `base_url`, which is what routes Graphiti traffic through llm-proxy. The
# MCP server only enables DNS-rebinding protection when it binds to
# localhost, and this stack binds 0.0.0.0 (config/graphiti-mcp-neo4j.yaml),
# so no source patch is required anymore.
FROM zepai/knowledge-graph-mcp:standalone

# Fail the build instead of silently calling api.openai.com at runtime if a
# future upstream image stops wiring the configured OpenAI base URL.
RUN python - <<'PY'
import re
from pathlib import Path

factories = Path("/app/mcp/src/services/factories.py").read_text()
pattern = r"CoreLLMConfig\([^)]*base_url\s*=\s*config\.providers\.openai\.api_url"
if not re.search(pattern, factories, re.S):
    raise SystemExit(
        "Graphiti OpenAI LLM factory no longer forwards base_url; update Dockerfile.graphiti-mcp"
    )
PY
